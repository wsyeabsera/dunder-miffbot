{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dunder-miffbot",
  // Pinned so a deploy cannot land on another account (same account as lite).
  "account_id": "3d134ec9e5eb3d05d601e9c6c2c071a5",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Worker runs first so it can refuse every file to a visitor without a session (worker/session.ts). Never remove run_worker_first:
  // without it the files are served before the Worker sees the request.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  // Five sign-in tries a minute per connection.
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
